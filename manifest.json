{
  "manifest_version": 3,
  "name": "Starry",
  "version": "1.2.0",
  "description": "Type text into focused web page fields at a chosen speed.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Starry"
  },
  "background": {
    "service_worker": "background.js"
  }
}
